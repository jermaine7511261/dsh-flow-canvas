      "data": {
        "type": "agent",
        "label": "网页搜索",
        "prompt": "使用 web_search 工具搜索关键词 \"{{query}}\"，收集前 10 条结果的标题、URL 和摘要。返回结构化的搜索结果列表。",
        "model": "deepseek-pro",
        "tools": ["web_search", "web_extract"],
        "writePaths": [],
        "readOnly": true,
        "maxSteps": 5
      }
    },
    {
      "id": "agent-analyze",
      "type": "agent",
      "position": { "x": 500, "y": 250 },
      "data": {
        "type": "agent",
        "label": "结果分析",
        "prompt": "分析搜索结果，提取关键信息：1) 每条结果的相关性评分(0-10) 2) 核心观点摘要 3) 信息覆盖度评估 4) 是否有明显信息缺口。输出 JSON 格式的分析报告。",
        "model": "deepseek-pro",
        "tools": ["read_file"],
        "writePaths": [],
        "readOnly": true,
        "maxSteps": 3
      }
    },
    {
      "id": "condition-1",
      "type": "condition",
      "position": { "x": 750, "y": 250 },
      "data": {
        "type": "condition",
        "label": "信息充足?",
        "conditionType": "string_contains",
        "conditionValue": "信息覆盖度高"
      }
    },
    {
      "id": "agent-refine",
      "type": "agent",
      "position": { "x": 1000, "y": 100 },
      "data": {
        "type": "agent",
