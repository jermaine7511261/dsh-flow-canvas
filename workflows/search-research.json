        "model": "deepseek-pro",
        "tools": ["web_search", "web_extract"],
        "writePaths": [],
        "readOnly": true,
        "maxSteps": 3
      }
    },
    {
      "id": "agent-synthesize",
      "type": "agent",
      "position": { "x": 1200, "y": 250 },
      "data": {
        "type": "agent",
        "label": "综合报告",
